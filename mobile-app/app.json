{
  "expo": {
    "name": "SIGEM - Emergencias",
    "slug": "emergencias-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "emergencias",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e40af"
        }
      ],
      "expo-location",
      "expo-image-picker",
      "expo-camera"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sigem.emergencias"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e40af"
      },
      "package": "com.sigem.emergencias",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    }
  }
}
